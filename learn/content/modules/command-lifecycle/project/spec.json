{
  "id": "command-lifecycle-project",
  "moduleId": "command-lifecycle",
  "title": "Build /gsd:skeptic (Full-Stack)",
  "description": "Extend your skeptic command with a Node.js handler and switch case, completing all 4 GSD command layers",
  "artifacts": [
    {
      "description": "Skeptic command spec (Module 1)",
      "path": "~/.claude/commands/gsd/skeptic.md",
      "checks": [
        { "pattern": "---[\\s\\S]*?---", "description": "Has YAML frontmatter block" },
        { "pattern": "name:\\s*gsd:skeptic", "description": "Has name field set to gsd:skeptic" },
        { "pattern": "description:", "description": "Has description field in frontmatter" },
        { "pattern": "allowed-tools:", "description": "Has allowed-tools field in frontmatter" },
        { "pattern": "<objective>[\\s\\S]*?</objective>", "description": "Has objective section" },
        { "pattern": "<execution_context>[\\s\\S]*?</execution_context>", "description": "Has execution_context section" },
        { "pattern": "@.*workflows/skeptic\\.md", "description": "execution_context references skeptic workflow via @file" },
        { "pattern": "<context>[\\s\\S]*?</context>", "description": "Has context section" },
        { "pattern": "<process>[\\s\\S]*?</process>", "description": "Has process section" }
      ]
    },
    {
      "description": "Skeptic workflow (Module 1)",
      "path": "~/.claude/get-shit-done/workflows/skeptic.md",
      "checks": [
        { "pattern": "<purpose>[\\s\\S]*?</purpose>", "description": "Has purpose section" },
        { "pattern": "<process>[\\s\\S]*?</process>", "description": "Has process section with steps" }
      ]
    },
    {
      "description": "Skeptic handler module",
      "path": "get-shit-done/bin/lib/skeptic.cjs",
      "checks": [
        { "pattern": "module\\.exports", "description": "File exports a module" },
        { "pattern": "function\\s+cmd", "description": "Follows the cmd* function naming convention" },
        { "pattern": "process\\.stdout\\.write|output\\(", "description": "Uses GSD output pattern" }
      ]
    },
    {
      "description": "Switch case for skeptic command",
      "path": "get-shit-done/bin/gsd-tools.cjs",
      "checks": [
        { "pattern": "case\\s+['\"]skeptic['\"]", "description": "Skeptic case exists in switch statement" }
      ]
    }
  ]
}
